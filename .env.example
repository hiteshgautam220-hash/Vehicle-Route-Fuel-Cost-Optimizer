# ===================================================================
# RouteWise Environment Configuration
# ===================================================================

# Server Port
PORT=5000

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongod)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/routewise?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/routewise
MONGODB_URI=mongodb://127.0.0.1:27017/routewise

# JWT Secret Key for token signing and verification
JWT_SECRET=routewise_secure_academic_jwt_secret_key_2026

# JWT Expiration Duration
JWT_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE_MB=2
UPLOAD_DIR=uploads

# CORS Allowed Origin (Default is * for development)
CLIENT_URL=http://localhost:5000
