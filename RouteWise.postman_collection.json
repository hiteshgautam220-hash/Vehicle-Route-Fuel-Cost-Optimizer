{
  "info": {
    "_postman_id": "7832a812-4291-4cf1-8c44-b892a0194e82",
    "name": "RouteWise Full-Stack REST API Collection",
    "description": "Comprehensive Postman test collection for RouteWise Vehicle Route & Multi-Fuel Cost Optimizer.\nCovers Health Check, Authentication, Profile & Avatar Upload, Saved Trips CRUD, City Fuel Rates, GIS City Streams, Route Calculations, Feedback, and Academic Syllabus Demos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health & Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Returns system uptime, Node runtime environment, and MongoDB connection status."
      }
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rajesh Pilot\",\n  \"email\": \"rajesh.pilot@example.com\",\n  \"password\": \"highway2026\",\n  \"fuelPreference\": \"cng\",\n  \"vehicleMileage\": 26\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
